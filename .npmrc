# 🔥 E5.8#4：@electron/get 专属镜像——electron 二进制下载读它（中国加速，@electron/get v5 实测仍读）。
# npm 11 警告 "Unknown project config" 无害（npm 不认此 key，@electron/get 自行读取）；下个 major 仍会警告——保留不动，勿删。
electron_mirror=https://npmmirror.com/mirrors/electron/

# E5.8#4：npm 安装强制校验 node 版本——配合 package.json engines "node": ">=24.0.0"。
# 错版本 npm install 立即 EBADENGINE 拒绝（不装到一半才炸）。开发机实锤 v24.16.0；Electron 43 自带 Node，engines 只管 dev 工具链 vite/tsc。
engine-strict=true

# E6#54b：@linkdesk 作用域只存在于官方 registry（npmmirror 不镜像新首发 scoped 包，2026-09-05 实测 404）。
# 根工程自 #54a 起壳源码 import @linkdesk/contracts（shared 组件类型重定向）；仅 @linkdesk 指官方，其余依赖继续走默认 npmmirror。
# 同款 per-scope 写法见 packages/plugin-sdk/.npmrc。
@linkdesk:registry=https://registry.npmjs.org/
