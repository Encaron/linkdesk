{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@src/*": ["./src/*"],
      // E5.8#20-c：插件类型消费路径——@linkdesk/contracts 直指仓库契约产物（#22.6 npm 包落位后切 "./contracts" 目录映射）
      "@linkdesk/contracts": ["./contracts/linkdesk.d.ts"]
    }
  },
  // 2026-09-05 塌平过渡式：include 由 plugins/builtin（双目录整体）→ 4 个仍在壳编译图内的 core:true 插件。
  // 不枚举全部 plugins/（serial-monitor 等 11 个潜伏类型错属 #16 各自独立 tsc 职责，塌平不扩覆盖）；
  // #15f scanPluginEntries 移除后壳不再编译任何插件代码 → 收为 ["src"]。
  "include": ["src", "plugins/editor", "plugins/file-tree", "plugins/marketplace", "plugins/settings"],
  "exclude": []
}
