{
  "name": "@linkdesk/ui",
  "version": "0.2.16",
  "description": "@linkdesk/ui——LinkDesk 共享 UI 组件的类型契约 + dev 解析体。L9 集中供给：组件代码与样式在运行时由壳池 vendor 单实例供给（壳改一处全生态跟随）；npm i 装的是类型与本地解析体，插件源码不 import 本包 css（lint 腿 check-ui-css-import 判红）。版本号与壳同号锁步（E6#124 重锚）。",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./index.css": "./dist/index.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.decl.json --noEmit --emitDeclarationOnly false",
    "prepack": "node scripts/build.mjs"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "dependencies": {
    "@linkdesk/contracts": "^0.1.0",
    "i18next": "^26.3.6",
    "react-i18next": "^17.0.10"
  },
  "devDependencies": {
    "lucide-react": "^1.29.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "keywords": [
    "linkdesk",
    "ui",
    "components"
  ],
  "license": "MIT"
}
