{
  "version": 1,
  "$comment": "尺寸域规格表（第七域）。唯一真相源：宿主 token 值 = src/index.css；此处是机器可读副本 + 语义 + 消费方 + 门禁类别。门禁 = scripts/check-size-tokens.mjs（挂 npm run check）；强制面 = 官方 FACTS 名单全部（官方仓），第三方仓不扫。⛔ 不在这里定义新的值——改值先改 src/index.css，再同步本表。",
  "tokens": [
    { "name": "--size-control-sm", "value": "24px", "category": "control", "semantics": "小号控件高度（工具条小钮 / 搜索钮）" },
    { "name": "--size-control-md", "value": "28px", "category": "control", "semantics": "标准控件高度（图标钮 / 工具条按钮）" },
    { "name": "--size-control-lg", "value": "32px", "category": "control", "semantics": "大号控件高度（主操作按钮 / 游戏面板钮）" },
    { "name": "--size-icon-sm", "value": "16px", "category": "icon", "semantics": "内联小图标（通知行 / 导航图标）" },
    { "name": "--size-icon-md", "value": "20px", "category": "icon", "semantics": "内联标准图标（徽标 / 行内标记）" },
    { "name": "--size-icon-lg", "value": "24px", "category": "icon", "semantics": "内联大图标（图标栏 / 插件卡图标）" },
    { "name": "--size-glyph-md", "value": "40px", "category": "glyph", "semantics": "图标块 / 磁贴标准尺寸（tile / 分类图标）" },
    { "name": "--size-glyph-lg", "value": "48px", "category": "glyph", "semantics": "图标块大号（tile.is-lg / hero 小图）" },
    { "name": "--size-ratio-card", "value": "3 / 2", "category": "media", "semantics": "卡片 / 详情默认媒体框比例" },
    { "name": "--size-ratio-hero", "value": "2 / 1", "category": "media", "semantics": "首屏 hero 媒体框比例" }
  ],
  "categories": {
    "control": { "properties": ["height", "min-height"], "selector": "(^|[-_])(btn|button|tbtn|sbtn|input|select|toolbar)($|[-_])" },
    "icon": { "properties": ["width", "height"], "selector": "icon" },
    "glyph": { "properties": ["width", "height"], "selector": "tile|glyph|avatar" },
    "media": { "properties": ["aspect-ratio"], "selector": "." }
  },
  "declaredGeometry": {
