{
  "$schema": "../../public/schemas/plugin.schema.json",
  "name": "Python",
  "version": "1.0.1",
  "marketIcon": "resources/cover.svg",
  "description": "Python 语言支持——语法高亮、跨文件跳转、智能补全",
  "author": "官方",
  "distribution": "user",
  "pluginRole": "data",
  "entry": "src/index.tsx",
  "contributes": {
    "langDefs": [
      {
        "id": "python",
        "extensions": [".py", ".pyi"],
        "lsp": {
          "command": "node",
          "args": ["node_modules/pyright/dist/pyright-langserver.js", "--stdio"]
        }
      }
    ]
  }
}
