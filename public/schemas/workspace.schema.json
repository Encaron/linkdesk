{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://serial-monitor-v3/workspace.schema.json",
  "title": "V3 Workspace Layout",
  "description": "Tab layout + card list. The tab structure is locked; the card fields are still open.",
  "type": "object",
  "required": ["tabs"],
  "properties": {
    "tabs": {
      "type": "array",
      "description": "All open tabs (flat array)",
      "items": {
        "type": "object",
        "required": ["id", "type", "label"],
        "properties": {
          "id": { "type": "string", "description": "Unique tab ID (UUID)" },
          "type": {
            "type": "string",
            "description": "Tab type — an arbitrary string (the plugin ID is the type). No longer a predefined enum."
          },
          "label": { "type": "string", "description": "Tab display text" },
          "dirty": { "type": "boolean", "description": "Whether there are unsaved changes" },
          "workspaceName": { "type": "string", "description": "Workspace name (workspace type only)" },
          "filePath": { "type": "string", "description": "File path (editor type only)" }
        },
        "additionalProperties": false
      }
    },
    "root": {
      "description": "Recursive split tree (SplitNode). leaf = pane, branch = direction + child nodes. The format is locked.",
      "$ref": "#/$defs/SplitNode"
    },
    "cards": {
      "type": "array",
      "description": "Card list (flat array; nesting is not allowed). Fields are not final yet.",
      "items": { "type": "object" }
    }
  },
  "$defs": {
    "SplitNode": {
      "description": "leaf: leaf pane | branch: split direction + two child nodes + size ratios",
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "groupId"],
          "properties": {
            "type": { "const": "leaf" },
            "groupId": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "direction", "children", "sizes"],
          "properties": {
            "type": { "const": "branch" },
            "direction": { "enum": ["horizontal", "vertical"] },
            "children": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": { "$ref": "#/$defs/SplitNode" }
            },
            "sizes": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": { "type": "number", "minimum": 0, "maximum": 100 }
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
