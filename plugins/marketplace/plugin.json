{
  "$schema": "../../public/schemas/plugin.schema.json",
  "pluginId": "marketplace",
  "name": "插件市场",
  "version": "1.0.28",
  "icon": "resources/icon.svg",
  "marketIcon": "resources/icon-brand.svg",
  "description": "浏览、安装和管理插件",
  "author": "官方",
  "distribution": "builtin",
  "core": true,
  "factoryRole": "marketplace",
  "entry": "src/index.tsx",
  "appearsIn": {
    "iconBar": "top",
    "sidePanel": true
  },
  "tabBehavior": {
    "singleton": true
  },
  "contributes": {
    "i18n": {
      "en": "i18n/en.json",
      "zh": "i18n/zh.json"
    },
    "configuration": {
      "title": "插件市场",
      "properties": {
        "marketplace.marketplaceSources": {
          "type": "array",
          "default": [
            "https://raw.githubusercontent.com/encaron/linkdesk-marketplace/main/marketplace.json"
          ],
          "description": "商店拉取哪些目录。官方目录内置；添加作者仓库 URL 即可发现该作者的插件（该仓库根目录需有 marketplace.json）。",
          "uiHint": "stringList"
        }
      }
    },
    "viewsContainers": {
      "marketplace": {
        "title": "插件市场",
        "location": "sidebar",
        "hideIfEmpty": false
      },
      "main": {
        "title": "插件详情",
        "location": "main",
        "hideIfEmpty": true
      }
    },
    "views": {
      "marketplace": [
        {
          "id": "search",
          "role": "toolbar",
          "title": "搜索",
          "render": "src/views/sidebar/SearchView.tsx",
          "order": -1
        },
        {
          "id": "installed",
          "title": "已安装",
          "render": "src/views/sidebar/InstalledListView.tsx",
          "order": 0
        },
        {
          "id": "explore",
          "title": "探索插件",
          "render": "src/views/sidebar/ExploreView.tsx",
          "order": 1,
          "collapsed": true
        },
        {
          "id": "disabled",
          "title": "已禁用",
          "render": "src/views/sidebar/DisabledListView.tsx",
          "order": 2,
          "collapsed": true
        },
        {
          "id": "builtin",
          "title": "内置",
          "render": "src/views/sidebar/BuiltinListView.tsx",
          "order": 3,
          "collapsed": true
        }
      ],
      "main": [
        {
          "id": "plugin-detail",
          "title": "插件详情",
          "render": "src/views/detail/DetailView.tsx"
        },
        {
          "id": "marketplace-install-confirm",
          "title": "确认安装",
          "render": "src/views/confirm/ConfirmInstall.tsx"
        }
      ]
    }
  }
}
