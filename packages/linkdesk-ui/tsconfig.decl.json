{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "rootDir": "../../src/components/shared",
    "outDir": "dist"
  },
  "include": [
    "../../src/components/shared/hooks/**/*.ts",
    "../../src/components/shared/overlay-portal/**/*.ts",
    "../../src/components/shared/overlay-portal/**/*.tsx",
    "../../src/components/shared/string-list-editor/**/*.ts",
    "../../src/components/shared/string-list-editor/**/*.tsx",
    "../../src/components/shared/context-menu/**/*.ts",
    "../../src/components/shared/context-menu/**/*.tsx",
    "../../src/components/shared/color-picker/**/*.ts",
    "../../src/components/shared/color-picker/**/*.tsx",
    "../../src/components/shared/select-box/**/*.ts",
    "../../src/components/shared/select-box/**/*.tsx",
    "../../src/components/shared/slider/**/*.ts",
    "../../src/components/shared/slider/**/*.tsx",
    "../../src/components/shared/toggle/**/*.ts",
    "../../src/components/shared/toggle/**/*.tsx",
    "../../src/components/shared/number-input/**/*.ts",
    "../../src/components/shared/number-input/**/*.tsx",
    "../../src/components/shared/button/**/*.ts",
    "../../src/components/shared/button/**/*.tsx",
    "../../src/components/shared/font-family-select/**/*.ts",
    "../../src/components/shared/font-family-select/**/*.tsx",
    "../../src/components/shared/file-path-input/**/*.ts",
    "../../src/components/shared/file-path-input/**/*.tsx",
    "../../src/components/shared/theme-picker/**/*.ts",
    "../../src/components/shared/theme-picker/**/*.tsx",
    "../../src/components/shared/segmented-radio/**/*.ts",
    "../../src/components/shared/segmented-radio/**/*.tsx",
    "../../src/components/shared/inline-input/**/*.ts",
    "../../src/components/shared/inline-input/**/*.tsx",
    "../../src/components/shared/combobox/**/*.ts",
    "../../src/components/shared/combobox/**/*.tsx",
    "../../src/components/shared/form-row/**/*.ts",
    "../../src/components/shared/form-row/**/*.tsx",
    "../../src/components/shared/plugin-icon/**/*.ts",
    "../../src/components/shared/plugin-icon/**/*.tsx",
    "../../src/components/shared/markdown-view/**/*.ts",
    "../../src/components/shared/markdown-view/**/*.tsx",
    "../../src/components/shared/badge/**/*.ts",
    "../../src/components/shared/badge/**/*.tsx",
    "../../src/components/shared/hint-card/**/*.ts",
    "../../src/components/shared/hint-card/**/*.tsx",
    "../../src/components/shared/hint-tip/**/*.ts",
    "../../src/components/shared/hint-tip/**/*.tsx",
    "../../src/components/shared/readonly-text/**/*.ts",
    "../../src/components/shared/readonly-text/**/*.tsx",
    "../../src/components/shared/section-subtitle/**/*.ts",
    "../../src/components/shared/section-subtitle/**/*.tsx",
    "../../src/components/shared/file-icon/**/*.ts",
    "../../src/components/shared/file-icon/**/*.tsx",
    "../../src/components/shared/settings-hints/**/*.ts",
    "../../src/components/shared/effective-badge/**/*.ts",
    "../../src/components/shared/effective-badge/**/*.tsx",
    "../../src/components/shared/source-badge/**/*.ts",
    "../../src/components/shared/source-badge/**/*.tsx",
    "../../src/components/shared/image-picker/**/*.ts",
    "../../src/components/shared/image-picker/**/*.tsx",
    "../../src/components/shared/segment-preview/**/*.ts",
    "../../src/components/shared/segment-preview/**/*.tsx",
    "../../src/components/shared/plugin-card/**/*.ts",
    "../../src/components/shared/plugin-card/**/*.tsx"
  ],
  "exclude": [
    "../../src/components/shared/**/*.test.ts",
    "../../src/components/shared/**/*.test.tsx",
    // HintTipRenderer 是壳池侧单例渲染器（消费 @src/core 的池命令表）——barrel 只导出 HintTip 糖件，
    // 故整支排除：仓外作者不该拿到它，也不该被它拖出 rootDir 之外的核心类型。
    "../../src/components/shared/hint-tip/HintTipRenderer.tsx"
  ]
}
