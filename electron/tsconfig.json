{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node10",
    "outDir": "../dist-electron",
    "rootDir": "..",
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "sourceMap": true,
    "esModuleInterop": true
  },
  "include": ["./**/*.ts", "../contracts/runtime-shapes.ts", "../src/types/global.d.ts", "../src/core/compat/dangling-scan.worker.ts"],
  "exclude": ["**/*.test.ts"]
}
