{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://serial-monitor-v3/workspace.schema.json",
  "title": "V3 Workspace Layout",
  "description": "标签页布局 + 卡片列表。Phase 3 已锁定标签页结构，Phase 5 卡片字段开放。",
  "type": "object",
  "required": ["tabs"],
  "properties": {
    "tabs": {
      "type": "array",
      "description": "所有打开的标签页（平铺数组）",
      "items": {
        "type": "object",
        "required": ["id", "type", "label"],
        "properties": {
          "id": { "type": "string", "description": "标签页唯一 ID（UUID）" },
          "type": {
            "type": "string",
            "enum": ["terminal", "workspace", "settings", "oled", "editor"],
            "description": "标签页类型"
          },
          "label": { "type": "string", "description": "标签页显示文本" },
          "dirty": { "type": "boolean", "description": "是否有未保存修改" },
          "workspaceName": { "type": "string", "description": "工作区名称（仅 workspace 类型）" },
          "filePath": { "type": "string", "description": "文件路径（仅 editor 类型）" }
        },
        "additionalProperties": false
      }
    },
    "root": {
      "description": "递归分屏树（SplitNode）。leaf=面板，branch=方向+子节点。Phase 3 格式已锁定。",
      "$ref": "#/$defs/SplitNode"
    },
    "cards": {
      "type": "array",
      "description": "Phase 5 卡片列表（平铺数组，禁止嵌套）。字段待锁定。",
      "items": { "type": "object" }
    }
  },
  "$defs": {
    "SplitNode": {
      "description": "leaf: 叶子面板 | branch: 分割方向 + 两个子节点 + 尺寸比例",
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "groupId"],
          "properties": {
            "type": { "const": "leaf" },
            "groupId": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "direction", "children", "sizes"],
          "properties": {
            "type": { "const": "branch" },
            "direction": { "enum": ["horizontal", "vertical"] },
            "children": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": { "$ref": "#/$defs/SplitNode" }
            },
            "sizes": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": { "type": "number", "minimum": 0, "maximum": 100 }
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
