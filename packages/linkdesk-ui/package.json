{
  "name": "@linkdesk/ui",
  "version": "0.2.1",
  "description": "@linkdesk/ui——LinkDesk 共享 UI 组件（右键/下拉/开关/取色器等）。壳 src/components/shared 单一源码经构建编译，插件作者 npm i 后与内置插件同款、自动跟随主题/玻璃的界面。",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./index.css": "./dist/index.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.decl.json --noEmit --emitDeclarationOnly false",
    "prepack": "node scripts/build.mjs"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "dependencies": {
    "@linkdesk/contracts": "^0.1.0",
    "i18next": "^26.3.6",
    "react-i18next": "^17.0.10"
  },
  "devDependencies": {
    "lucide-react": "^1.29.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "keywords": [
    "linkdesk",
    "ui",
    "components"
  ],
  "license": "MIT"
}
