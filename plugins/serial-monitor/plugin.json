{
  "$schema": "../../public/schemas/plugin.schema.json",
  "name": "串口监视器",
  "version": "1.0.5",
  "icon": "resources/icon-bar.svg",
  "marketIcon": "resources/icon.svg",
  "description": "串口数据监视器——接收区（CM6）+ 发送栏（Monaco）+ 侧栏设置。LinkDesk 第一个视图插件，通用容器基础设施在此验证。不绑定任何特定用途。",
  "author": "官方",
  "entry": "src/index.tsx",
  "appearsIn": { "iconBar": "top", "sidePanel": true, "tabBar": true, "statusBar": "src/components/statusBar.tsx" },
  "tabBehavior": {
    "invokeBeforeClose": "close_port",
    "identityField": "sourceId"
  },
  "statusBar": [
    { "id": "connection", "icon": "circle-filled", "label": "", "align": "left" }
  ],
  "contributes": {
    "i18n": { "en": "i18n/en.json" },
    "viewsContainers": {
      "serial-monitor": {
        "title": "串口监视器",
        "location": "sidebar",
        "hideIfEmpty": false
      }
    },
    "views": {
      "serial-monitor": [
        {
          "id": "sessions",
          "title": "串口监视器会话",
          "render": "src/views/SessionListView.tsx",
          "order": 0,
          "minHeight": 120
        },
        {
          "id": "receive-and-send",
          "title": "收发设置",
          "render": "src/views/SerialSettingsView.tsx",
          "order": 1,
          "minHeight": 500
        }
      ]
    },
    "configuration": {
      "title": "串口监视器",
      "properties": {
        "serial-monitor.statusBar.connection": {
          "type": "boolean",
          "default": true,
          "description": "状态栏显示连接状态指示灯"
        },
        "serial-monitor.confirmOnClose": {
          "type": "boolean",
          "default": true,
          "description": "关闭时提示"
        }
      }
    },
    "configurationDefaults": {
      "serial-monitor.statusBar.connection": true,
      "serial-monitor.confirmOnClose": true
    },
    "commands": [
      { "id": "serial-monitor.copy", "title": "复制", "category": "串口监视器", "when": "activeEditor == 'serial-monitor'" },
      { "id": "serial-monitor.selectAll", "title": "全选", "category": "串口监视器", "when": "activeEditor == 'serial-monitor'" },
      { "id": "serial-monitor.clear", "title": "清空接收区", "category": "串口监视器", "when": "activeEditor == 'serial-monitor'" },
      { "id": "serial-monitor.clearSend", "title": "清空发送区", "category": "串口监视器", "when": "activeEditor == 'serial-monitor'" },
      { "id": "serial-monitor.togglePause", "title": "暂停接收", "category": "串口监视器", "when": "activeEditor == 'serial-monitor' && sourceOpen" },
      { "id": "serial-monitor.exportLog", "title": "导出日志", "category": "串口监视器", "when": "activeEditor == 'serial-monitor'" },
      { "id": "serial-monitor.toggleSendMode", "title": "切换到 HEX 发送", "category": "串口监视器", "when": "activeEditor == 'serial-monitor'" },
      { "id": "serial-monitor.toggleEcho", "title": "关闭消息回显", "category": "串口监视器", "when": "activeEditor == 'serial-monitor'" },
      { "id": "serial-monitor.toggleLineNumbers", "title": "隐藏行号", "category": "串口监视器", "when": "activeEditor == 'serial-monitor'" },
      { "id": "serial-monitor.quickSendFill", "title": "回填到发送区", "category": "串口监视器", "when": "activeEditor == 'serial-monitor'" },
      { "id": "serial-monitor.quickSendEdit", "title": "编辑", "category": "串口监视器", "when": "activeEditor == 'serial-monitor'" },
      { "id": "serial-monitor.quickSendDelete", "title": "删除", "category": "串口监视器", "when": "activeEditor == 'serial-monitor'" }
    ],
    "menus": {
      "editorContext": [
        { "command": "serial-monitor.copy", "group": "edit", "when": "activeEditor == 'serial-monitor'" },
        { "command": "serial-monitor.selectAll", "group": "edit", "when": "activeEditor == 'serial-monitor'" },
        { "command": "serial-monitor.clear", "group": "serial-monitor", "when": "activeEditor == 'serial-monitor'" },
        { "command": "serial-monitor.togglePause", "group": "serial-monitor", "when": "activeEditor == 'serial-monitor' && sourceOpen" }
      ],
      "quickSendContext": [
        { "command": "serial-monitor.quickSendFill", "group": "edit" },
        { "command": "serial-monitor.quickSendEdit", "group": "edit" },
        { "command": "serial-monitor.quickSendDelete", "group": "delete" }
      ],
      "commandPalette": [
        { "command": "serial-monitor.clear", "when": "activeEditor == 'serial-monitor'" },
        { "command": "serial-monitor.clearSend", "when": "activeEditor == 'serial-monitor'" },
        { "command": "serial-monitor.togglePause", "when": "activeEditor == 'serial-monitor' && sourceOpen" },
        { "command": "serial-monitor.exportLog", "when": "activeEditor == 'serial-monitor'" },
        { "command": "serial-monitor.toggleSendMode", "when": "activeEditor == 'serial-monitor'" },
        { "command": "serial-monitor.toggleEcho", "when": "activeEditor == 'serial-monitor'" },
        { "command": "serial-monitor.toggleLineNumbers", "when": "activeEditor == 'serial-monitor'" }
      ]
    }
  },
  "recommends": [
    { "plugin": "workspace", "reason": "配合卡片可视化串口数据" }
  ],
  "suggests": [
    { "plugin": "protocol-bracket", "reason": "协议解析——不装则只能查看原始数据" }
  ],
  "changelog": [
    { "version": "1.0.5", "date": "2026-09-09", "changes": ["图标身份分工（E6#69 三图模型）：icon → resources/icon-bar.svg（Type-1 线稿剪影，仅图标栏用）；marketIcon → resources/icon.svg（Type-2 彩色身份图，市场列表/详情/标签栏同用）；整幅封面迁入 README 展示"] },
    { "version": "1.0.4", "date": "2026-09-09", "changes": ["小图标 icon.png → resources/icon.svg 彩 SVG 品牌块（E6#68b 现存非 SVG 清零）——图标栏/侧栏行显青绿数据帧色块，市场展示位仍用 cover.svg"] },
    { "version": "1.0.3", "date": "2026-09-09", "changes": ["声明 marketIcon=resources/cover.svg——市场详情展示位显「串口的窗」封面（E6#67 双图标样本：图标栏仍读 icon.png 小图标，市场读 marketIcon 展示图）"] },
    { "version": "1.0.2", "date": "2026-09-08", "changes": ["状态栏组件随包自声明——appearsIn.statusBar 改路径字符串（E6#62d）——SDK 编 statusBar.bundle.js 进 .linkdesk-plugin，池按 dist 消费，灯/口数不再编入壳池"] },
    { "version": "1.0.1", "date": "2026-09-07", "changes": ["状态栏组件存在性改声明式（appearsIn.statusBar）——打包版修复连接灯/口数实时渲染"] },
    { "version": "1.0.0", "date": "2026-07-19", "changes": ["初始发布", "串口工具栏", "CM6 接收区 + Monaco 发送栏", "侧栏设置（时间戳/编码/换行符）"] }
  ]
}
