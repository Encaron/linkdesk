{
  "name": "linkdesk-plugin-python",
  "version": "1.0.4",
  "private": true,
  "type": "module",
  "description": "Python 语言支持——独立仓可自足构建：build 走 @linkdesk/plugin-sdk 的 npm 通道。pyright 自声明（E6#15e：LSP 二进制随 zip 自带，壳打包链路不含它）",
  "scripts": {
    "dev": "linkdesk-plugin-sdk dev",
    "dev:real": "linkdesk-plugin-sdk dev --real",
    "build": "linkdesk-plugin-sdk build",
    "validate": "linkdesk-plugin-sdk validate",
    "lint": "linkdesk-plugin-sdk lint",
    "publish": "linkdesk-plugin-sdk publish"
  },
  "dependencies": {
    "pyright": "^1.1.413"
  },
  "devDependencies": {
    "@linkdesk/plugin-sdk": "^0.1.14",
    "@types/react": "^18.3.12",
    "typescript": "^5.6.3"
  }
}
