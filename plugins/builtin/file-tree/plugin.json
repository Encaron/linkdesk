{
  "$schema": "../../public/schemas/plugin.schema.json",
  "name": "文件树",
  "version": "1.0.0",
  "icon": "FolderTree",
  "iconSource": "lucide",
  "description": "浏览和管理文件——对标 VS Code 资源管理器",
  "author": "官方",
  "distribution": "builtin",
  "core": true,
  "entry": "src/index.tsx",
  "appearsIn": { "iconBar": "top", "sidePanel": true },
  "tabBehavior": {
    "singleton": true
  },
  "contributes": {
    "i18n": { "en": "i18n/en.json" },
    "viewsContainers": {
      "explorer": { "title": "资源管理器", "location": "sidebar" }
    },
    "views": {
      "explorer": [
        { "id": "folders", "title": "", "render": "src/views/FoldersView.tsx", "order": 0 },
        { "id": "search", "title": "搜索", "render": "src/views/SearchView.tsx", "order": 1 }
      ]
    },
    "commands": [
      { "id": "revealInExplorer", "title": "在文件树中显示" },
      { "id": "explorer.newFile", "title": "新建文件" },
      { "id": "explorer.newFolder", "title": "新建文件夹" },
      { "id": "explorer.openFile", "title": "打开" },
      { "id": "explorer.openToSide", "title": "在侧边打开" },
      { "id": "explorer.openWith", "title": "打开方式…" },
      { "id": "explorer.openFocused", "title": "打开聚焦项" },
      { "id": "explorer.openInTerminal", "title": "在终端中打开" },
      { "id": "explorer.revealInOS", "title": "在文件管理器中显示" },
      { "id": "explorer.copyPath", "title": "复制路径" },
      { "id": "explorer.copyRelativePath", "title": "复制相对路径" },
      { "id": "explorer.cut", "title": "剪切" },
      { "id": "explorer.copy", "title": "复制" },
      { "id": "explorer.paste", "title": "粘贴" },
      { "id": "explorer.rename", "title": "重命名" },
      { "id": "explorer.delete", "title": "删除" },
      { "id": "explorer.findInFolder", "title": "在文件夹中查找…" },
      { "id": "explorer.refresh", "title": "刷新资源管理器" },
      { "id": "explorer.collapseAll", "title": "收起所有文件夹" },
      { "id": "explorer.openFolder", "title": "打开文件夹…" },
      { "id": "explorer.search", "title": "搜索" }
    ],
    "keybindings": [
      { "key": "Ctrl+Shift+E",   "command": "workbench.view.explorer" },
      { "key": "Ctrl+N",        "command": "explorer.newFile",        "when": "explorerFocus" },
      { "key": "Ctrl+Shift+N",  "command": "explorer.newFolder",      "when": "explorerFocus" },
      { "key": "Enter",          "command": "explorer.openFocused",    "when": "explorerFocus && !inputFocus" },
      { "key": "Ctrl+Enter",    "command": "explorer.openToSide",     "when": "explorerFocus && explorerItemIsFile" },
      { "key": "Ctrl+Shift+F", "command": "explorer.search" }
    ],
    "configuration": {
      "title": "资源管理器",
      "properties": {
        "explorer.sortOrder": {
          "type": "string",
          "enum": ["default", "mixed", "filesFirst", "type", "modified", "foldersNestsFiles"],
          "default": "default",
          "description": "文件树排序方式"
        },
        "explorer.compactFolders": {
          "type": "boolean",
          "default": true,
          "description": "紧凑文件夹——单子目录压缩为单行路径"
        },
        "explorer.expandOnClick": {
          "type": "boolean",
          "default": false,
          "description": "点击目录行即可展开/折叠——关闭后只有 twistie 小三角管展开折叠，点目录行仅选中"
        },
        "explorer.autoReveal": {
          "type": "boolean",
          "default": true,
          "description": "切换编辑器标签页时自动在文件树中定位"
        },
        "explorer.confirmDelete": {
          "type": "boolean",
          "default": true,
          "description": "删除文件/文件夹前弹出确认框"
        },
        "explorer.confirmDragAndDrop": {
          "type": "boolean",
          "default": true,
          "description": "拖放移动文件前弹出确认框"
        },
        "explorer.enableDragAndDrop": {
          "type": "boolean",
          "default": true,
          "description": "启用文件树拖放"
        },
        "explorer.expandSingleFolderWorkspaces": {
          "type": "boolean",
          "default": true,
          "description": "打开文件夹时自动展开根节点"
        },
        "explorer.incrementalNaming": {
          "type": "string",
          "enum": ["smart", "disabled"],
          "default": "smart",
          "description": "重名文件自动加数字后缀（如 test-1.txt）"
        },
        "explorer.excludeGitIgnore": {
          "type": "boolean",
          "default": true,
          "description": "读取 .gitignore 排除文件"
        },
        "explorer.autoOpenDroppedFile": {
          "type": "boolean",
          "default": false,
          "description": "从资源管理器拖入文件后自动打开"
        },
        "explorer.fileNesting.enabled": {
          "type": "boolean",
          "default": false,
          "description": "文件嵌套——相关文件折叠为父文件的子节点"
        },
        "explorer.fileNesting.expand": {
          "type": "boolean",
          "default": true,
          "description": "文件嵌套默认展开"
        },
        "explorer.decorations.colors": {
          "type": "boolean",
          "default": true,
          "description": "文件装饰器——颜色标记"
        },
        "explorer.decorations.badges": {
          "type": "boolean",
          "default": true,
          "description": "文件装饰器——徽章标记"
        },
        "files.exclude": {
          "type": "object",
          "default": {
            "**/node_modules": true,
            "**/.git": true
          },
          "description": "glob 模式排除文件/文件夹"
        },
        "terminal.external.windowsExec": {
          "type": "string",
          "enum": ["powershell", "cmd", "wt", "git-bash", "custom"],
          "default": "powershell",
          "enumDescriptions": {
            "powershell": "PowerShell（Windows 默认）",
            "cmd": "命令提示符",
            "wt": "Windows Terminal",
            "git-bash": "Git Bash",
            "custom": "自定义命令…"
          },
          "description": "右键'在终端中打开'时使用的外部终端。选'自定义'后在下方的命令模板中填写启动命令。"
        },
        "terminal.external.customCommand": {
          "type": "string",
          "default": "",
          "description": "自定义终端启动命令。用 {{dirPath}} 表示目标目录。例: wt -d \"{{dirPath}}\""
        }
      }
    }
  }
}
