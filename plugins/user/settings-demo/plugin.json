{
  "$schema": "../../public/schemas/plugin.schema.json",
  "name": "漂亮设置",
  "version": "1.1.0",
  "icon": "resources/icon.png",
  "description": "设置 UI 参考实现（作者路径验证 E5.8#41.14 子D，E5.8#41.17 大改）——非内置副本：按工厂角色并存 mockup 形态二「漂亮设置」从零编排（banner 头 + 卡片分区 + 右下角胶囊切换套 + 快捷键键帽卡），自包含类命名空间 .settings-demo/.sd-* 零跨插件 CSS 泄漏。与内置设置并存，factoryRole=settings 双候选，可在设置页通用区切换激活套。演示用途，可卸载重装。",
  "author": "官方",
  "distribution": "user",
  "factoryRole": "settings",
  "entry": "src/index.tsx",
  "appearsIn": { "iconBar": "bottom", "tabBar": true },
  "tabBehavior": {
    "singleton": true
  },
  "contributes": {
    "i18n": { "en": "i18n/en.json" },
    "viewsContainers": {
      "settings": {
        "title": "设置",
        "location": "auxiliarybar"
      }
    },
    "views": {
      "settings": [
        {
          "id": "settings",
          "title": "设置",
          "render": "src/views/SettingsView.tsx",
          "order": 0
        }
      ]
    },
    "floatingPanel": { "viewId": "settings" }
  }
}
