{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://embeddesk.app/schemas/plugin.schema.json",
  "title": "插件元数据",
  "description": "plugin.json 的 JSON Schema——⚠️ 此文件仅供文档参考。权威版本在 public/schemas/plugin.schema.json。插件的 $schema 字段应指向 ../../public/schemas/plugin.schema.json。",
  "type": "object",
  "required": ["name", "version"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema 引用——IDE 自动补全用",
      "$comment": "$schema 仅用于 IDE 自动补全，运行时不做 JSON Schema 验证"
    },
    "type": {
      "type": "string",
      "description": "【已废弃】插件类型——不再必需。loader 从 entry/mode/themes/languages/resources 等声明字段自动检测贡献类型。保留仅用于向后兼容。",
      "enum": ["view", "card", "theme", "language", "protocol", "resource", "datasource"]
    },
    "core": {
      "type": "boolean",
      "description": "核心控制面插件——不可卸载，卸载按钮在 UI 中不显示或禁用。外壳依赖此插件提供基础交互能力（如设置页、插件市场）。无此声明 = 普通插件，用户可自由装卸。默认 false。",
      "default": false
    },
    "factoryRole": {
      "type": "string",
      "description": "系统插槽角色——声明此插件填充哪个系统级功能。settings=设置页（Ctrl+, 打开），marketplace=插件市场。多个插件声明同一 role → 第一个 core: true 的胜出。",
      "enum": ["settings", "marketplace"]
    },
    "distribution": {
      "type": "string",
      "enum": ["builtin", "user"],
      "default": "user",
      "description": "分发渠道——builtin=内置（随安装包分发，放 plugins/builtin/），user=用户安装（放 plugins/user/）。第三方插件不填即可，默认 user。"
    },
    "name": {
      "type": "string",
      "description": "显示名称",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "description": "语义化版本",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "icon": {
      "type": "string",
      "description": "图标标识——codicon 名称或文件路径"
    },
    "iconSource": {
      "type": "string",
      "description": "图标来源",
      "enum": ["codicon", "svg", "url", "lucide"],
      "default": "codicon"
    },
    "description": {
      "type": "string",
      "description": "一句话描述，插件详情页展示。支持多行"
    },
    "author": {
      "type": "string",
      "description": "作者名"
    },
    "entry": {
      "type": "string",
      "description": "入口文件路径，相对插件目录。view/card/protocol 必需"
    },
    "sidebar": {
      "type": "string",
      "description": "侧栏组件路径，仅 view 类型有效",
      "$comment": "由 Vite glob 自动发现，无需插件声明"
    },
    "tabBehavior": {
      "type": "object",
      "description": "标签页行为声明——核心读此字段决定去重/保底/关闭确认",
      "properties": {
        "isFallback": {
          "type": "boolean",
          "description": "场上无标签页时自动创建此标签页，且不可关闭",
          "default": false
        },
        "singleton": {
          "type": "boolean",
          "description": "全局只允许一个实例",
          "default": false
        },
        "confirmOnClose": {
          "type": "string",
          "description": "关闭前弹出确认对话框，值为提示文本"
        },
        "invokeBeforeClose": {
          "type": "string",
          "description": "关闭前调用的命令（在 confirmOnClose 确认之后、标签页关闭之前）。如终端声明 \"close_port\"（否决回路已停用 E5.7#43，声明保留待未来池侧 requests 命名空间）"
        },
        "identityField": {
          "type": "string",
          "description": "CreateTabOptions 中用于判断标签页身份的唯一字段。不声明=允许多实例不去重。如 workspace 声明 \"workspaceName\"——同名工作台只允许一个标签页。"
        }
      },
      "additionalProperties": false
    },
    "statusBar": {
      "type": "array",
      "description": "状态栏贡献条目",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "description": "唯一标识" },
          "icon": { "type": "string", "description": "codicon 名称或 SVG 路径" },
          "label": { "type": "string", "description": "显示文字" },
          "align": { "type": "string", "enum": ["left", "right"], "default": "left" },
          "onClick": { "type": "string", "description": "点击行为——命令名" },
          "configurable": { "type": "boolean", "description": "声明 true → 壳自动注册配置项并注入 visible prop。插件作者只写一行 JSON，零代码。", "default": false }
        },
        "additionalProperties": false
      }
    },
    "file": {
      "type": "string",
      "description": "单文件入口——theme/language 类型用。和 themes/languages 二选一"
    },
    "themes": {
      "type": "array",
      "description": "多主题数组，仅 theme 类型",
      "items": {
        "type": "object",
        "required": ["id", "name", "file"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "file": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "languages": {
      "type": "array",
      "description": "多语言数组，仅 language 类型",
      "items": {
        "type": "object",
        "required": ["code", "name", "file"],
        "properties": {
          "code": { "type": "string" },
          "name": { "type": "string" },
          "file": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "mode": {
      "type": "string",
      "description": "协议模式。text = Phase 4 可用；binary = Phase 6+ WASM",
      "enum": ["text", "binary"],
      "default": "text"
    },
    "resources": {
      "type": "array",
      "description": "资源文件列表，仅 resource 类型",
      "items": { "type": "string" }
    },
    "recommends": {
      "type": "array",
      "description": "推荐同时安装的插件",
      "items": {
        "type": "object",
        "required": ["plugin", "reason"],
        "properties": {
          "plugin": { "type": "string" },
          "reason": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "suggests": {
      "type": "array",
      "description": "可选相关插件",
      "items": {
        "type": "object",
        "required": ["plugin", "reason"],
        "properties": {
          "plugin": { "type": "string" },
          "reason": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "requires": {
      "type": "array",
      "description": "插件级激活顺序依赖（E5.8#13）——按 pluginId 声明，加载时先加载依赖再加载本插件。无版本约束。缺依赖 → 插件挂起（PENDING），依赖就绪自动加载。",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "changelog": {
      "type": "array",
      "description": "更新日志",
      "items": {
        "type": "object",
        "required": ["version", "date"],
        "properties": {
          "version": { "type": "string" },
          "date": { "type": "string" },
          "changes": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "screenshots": {
      "type": "array",
      "description": "截图 URL 数组",
      "$comment": "Phase 6 PluginDetailView 增强时启用",
      "items": { "type": "string" }
    },
    "minAppVersion": {
      "type": "string",
      "description": "最低软件版本要求"
    },
    "docs": {
      "type": "string",
      "description": "附带文档路径（资源插件联动）",
      "$comment": "Phase 6 文档链接"
    },
    "cardDocMap": {
      "type": "object",
      "description": "卡片 ID → 文档锚点映射",
      "$comment": "Phase 8 卡片文档映射",
      "additionalProperties": { "type": "string" }
    },
    "i18n": {
      "type": "object",
      "description": "插件自带翻译文件",
      "additionalProperties": { "type": "string" }
    },
    "cssVars": {
      "type": "object",
      "description": "插件自定义 CSS 变量",
      "$comment": "Phase 7 启用——插件注入 CSS 变量到 :root",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "dark": { "type": "string" },
          "light": { "type": "string" }
        }
      }
    },
    "permissions": {
      "type": "array",
      "description": "权限声明",
      "$comment": "Phase 6 启用——serial/filesystem/network 权限白名单",
      "items": {
        "type": "string",
        "enum": ["serial", "filesystem", "network"]
      }
    },
    "appearsIn": {
      "type": "object",
      "description": "插件 UI 出现位置——声明式。替代 iconLocation+viewRole+keepSidebarOnFocus。不声明 = 不出现。",
      "properties": {
        "iconBar": { "type": "string", "enum": ["top", "bottom"], "description": "图标栏位置，不填=不显示图标" },
        "sidePanel": { "type": "boolean", "description": "有侧栏视图容器，默认 false" },
        "tabBar": { "type": "boolean", "description": "可作为标签页打开（需 entry），默认 false" },
        "statusBar": { "type": "boolean", "description": "有状态栏条目，默认 false" }
      }
    },
    "contributes": {
      "type": "object",
      "description": "贡献点声明——对标 VS Code package.json contributes。Phase 5 核心机制。",
      "properties": {
        "commands": {
          "type": "array",
          "description": "注册命令——CommandPalette/右键菜单/快捷键的消费源",
          "items": {
            "type": "object",
            "required": ["id", "title"],
            "properties": {
              "id": { "type": "string", "description": "命令 ID——如 terminal.clear" },
              "title": { "type": "string", "description": "显示名称" },
              "category": { "type": "string", "description": "命令面板分组" },
              "when": { "type": "string", "description": "context key when 条件——如 activeEditor == 'terminal'" }
            },
            "additionalProperties": false
          }
        },
        "menus": {
          "type": "object",
          "description": "菜单项声明——按 MenuId 分组",
          "propertyNames": {
            "enum": ["commandPalette", "tabContext", "editorContext", "extensionGear", "menuBar", "fileContext", "cardContext", "quickSendContext", "iconBar"]
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "oneOf": [
                { "type": "string", "description": "命令 ID（简写）" },
                {
                  "type": "object",
                  "required": ["command"],
                  "properties": {
                    "command": { "type": "string", "description": "命令 ID" },
                    "group": { "type": "string", "description": "分组——navigation/edit/terminal/delete/split" },
                    "when": { "type": "string", "description": "context key when 条件" }
                  },
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "keybindings": {
          "type": "array",
          "description": "快捷键绑定",
          "items": {
            "type": "object",
            "required": ["command", "key"],
            "properties": {
              "command": { "type": "string" },
              "key": { "type": "string", "description": "如 ctrl+k" },
              "when": { "type": "string", "description": "context key when 条件" }
            },
            "additionalProperties": false
          }
        },
        "configuration": {
          "type": "object",
          "description": "设置项声明——Settings Editor 自动渲染",
          "required": ["title", "properties"],
          "properties": {
            "title": { "type": "string", "description": "设置分组名" },
            "properties": {
              "type": "object",
              "description": "设置项映射——key → { type, default, enum?, description }",
              "additionalProperties": {
                "type": "object",
                "required": ["type", "default", "description"],
                "properties": {
                  "type": { "type": "string", "enum": ["string", "number", "boolean"] },
                  "default": {},
                  "enum": { "type": "array" },
                  "description": { "type": "string" }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "configurationDefaults": {
          "type": "object",
          "description": "弱默认值——插件给其他配置项的建议值，用户手动设置优先",
          "additionalProperties": {}
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "type": { "const": "view" } }
      },
      "then": {
        "required": ["entry"]
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "card" } }
      },
      "then": {
        "required": ["entry"]
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "protocol" } }
      },
      "then": {
        "required": ["entry"]
      }
    }
  ],
  "additionalProperties": false
}
