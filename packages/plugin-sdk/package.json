{
  "name": "@linkdesk/plugin-sdk",
  "version": "0.1.66",
  "description": "@linkdesk/plugin-sdk——LinkDesk 插件作者 SDK（对标 @types/vscode）：window.linkdesk.* 类型 + 一键 build(.linkdesk-plugin) + dev 宿主 + plugin.json 验证 + eslint 门禁（E6#54d）。作者 npm i 后零壳源码依赖。",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./eslint": {
      "types": "./dist/eslint/index.d.ts",
      "default": "./dist/eslint/index.js"
    },
    "./vitest-setup": {
      "types": "./dist/vitest-setup.d.ts",
      "default": "./dist/vitest-setup.js"
    },
    "./test-audit": {
      "types": "./test-audit.d.ts",
      "default": "./test-audit.mjs"
    },
    "./svg-wellformed": {
      "types": "./svg-wellformed.d.ts",
      "default": "./svg-wellformed.mjs"
    },
    "./package.json": "./package.json",
    "./own-dict-coverage": {
      "types": "./own-dict-coverage.d.ts",
      "default": "./own-dict-coverage.mjs"
    }
  },
  "files": [
    "dist",
    "schemas",
    "dev-host",
    "test-audit.mjs",
    "test-audit.d.ts",
    "svg-wellformed.mjs",
    "svg-wellformed.d.ts",
    "own-dict-coverage.mjs",
    "own-dict-coverage.d.ts"
  ],
  "sideEffects": false,
  "bin": {
    "linkdesk-plugin-sdk": "./dist/bin.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@linkdesk/contracts": "^0.1.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "ajv": "^8.17.1",
    "eslint": "^9.0.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "i18next": "^26.3.6",
    "jsonc-parser": "^3.3.1",
    "jszip": "^3.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.10",
    "saxes": "^6.0.0",
    "vite": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "linkdesk",
    "plugin",
    "sdk",
    "vite"
  ],
  "license": "MIT"
}
