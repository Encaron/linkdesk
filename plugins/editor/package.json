{
  "name": "linkdesk-plugin-editor",
  "version": "1.0.9",
  "private": true,
  "type": "module",
  "description": "Monaco 编辑器（出厂预装，可卸载）——独立仓可自足构建：build 走 @linkdesk/plugin-sdk 的 npm 通道。monaco-editor + monaco-languageclient 自声明随 zip inline（E6#16 谁消费谁声明——壳零插件依赖），零 @src",
  "scripts": {
    "dev": "linkdesk-plugin-sdk dev",
    "dev:real": "linkdesk-plugin-sdk dev --real",
    "build": "linkdesk-plugin-sdk build",
    "validate": "linkdesk-plugin-sdk validate",
    "lint": "linkdesk-plugin-sdk lint",
    "publish": "linkdesk-plugin-sdk publish"
  },
  "dependencies": {
    "monaco-editor": "^0.55.1",
    "monaco-languageclient": "^10.7.0"
  },
  "devDependencies": {
    "@linkdesk/plugin-sdk": "^0.1.14",
    "@types/react": "^18.3.12",
    "typescript": "^5.6.3"
  }
}
